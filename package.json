{
  "name": "loadbearing",
  "private": true,
  "//type": "Required, not cosmetic: api/ has no package.json of its own, so this one decides its module format. Without it the deployed function is compiled as CommonJS and dies requiring the ESM server it imports.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "npm-run-all build:shared --parallel dev:shared dev:server dev:client",
    "dev:shared": "npm --workspace shared run dev",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm run build:shared && npm run build:client",
    "build:shared": "npm run build --workspace @loadbearing/shared",
    "build:client": "npm run build --workspace @loadbearing/client",
    "test": "npm-run-all build:shared test:shared test:server test:client",
    "test:shared": "npm --workspace shared run test",
    "test:server": "npm --workspace server run test",
    "test:client": "npm --workspace client run test",
    "typecheck": "npm-run-all build:shared typecheck:api typecheck:server typecheck:client",
    "typecheck:api": "tsc --noEmit -p tsconfig.json",
    "typecheck:server": "npm --workspace server run typecheck",
    "typecheck:client": "npm --workspace client run typecheck",
    "//build": "Plain && rather than npm-run-all: this is the script the deployment runs, and npm-run-all is a devDependency that a production install is entitled to skip."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2"
  }
}
