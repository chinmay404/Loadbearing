# Copy to .env for local use, or paste these into Vercel's environment variables.
# .env is gitignored: never commit a real connection string or API key.

# ---- database ----
# Absent  → local SQLite file at data/loadbearing.sqlite (no setup, no service).
# Present → Postgres. For Supabase use the CONNECTION POOLER string, not the
# direct db.<ref>.supabase.co one: a serverless function opens a connection per
# invocation and would exhaust the direct-connection limit, and the direct host
# is IPv6-only on newer projects. Copy it from
# Supabase → Project Settings → Database → Connection string → Transaction pooler.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- sessions ----
# REQUIRED in production. Signs the session cookie; rotating it logs everyone out.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LOADBEARING_SESSION_SECRET=

# ---- grader model (all optional) ----
# A key here belongs to the whole instance: anyone signed in who has not saved
# their own key will use it, and you pay for their reviews. Leave it unset if you
# want every account to bring its own.
# LOADBEARING_API_KEY=
# LOADBEARING_PROVIDER=openai-compatible      # or: anthropic
# LOADBEARING_BASE_URL=https://api.groq.com/openai/v1
# LOADBEARING_MODEL=llama-3.3-70b-versatile

# ---- local development only ----
# FAKE_LLM=1                 # offline canned reviews; the UI shows a banner while set
# LOADBEARING_DB=data/scratch.sqlite
# LOADBEARING_EXPORT_DIR=D:\Obsidian_notes_206\Notes\Loadbearing
# PORT=8787
